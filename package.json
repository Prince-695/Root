{
  "name": "root-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Root — pure-engineering terminal CLI that scaffolds and interconnects production-grade backends (Turborepo monorepo).",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --filter=@root/cli",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "root-cli": "node packages/cli/dist/cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.8",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
