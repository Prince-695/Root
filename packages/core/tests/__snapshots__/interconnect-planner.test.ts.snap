    "content": "import type { Request, Response, NextFunction } from \\"express\\";\\nimport {\\n  createPostsRecord,\\n  getPostsRecord,\\n  listPostsRecords,\\n} from \\"../services/posts.service.js\\";\\n\\nexport async function listPosts(_req: Request, res: Response, next: NextFunction) {\\n  try {\\n    const data = await listPostsRecords();\\n    res.status(200).json({ success: true, data });\\n  } catch (error) {\\n    next(error);\\n  }\\n}\\n\\nexport async function getPostsById(req: Request, res: Response, next: NextFunction) {\\n  try {\\n    const id = String(req.params.id);\\n    const data = await getPostsRecord(id);\\n    if (!data) {\\n      res.status(404).json({ success: false, error: { message: \\"Posts not found\\" } });\\n      return;\\n    }\\n    res.status(200).json({ success: true, data });\\n  } catch (error) {\\n    next(error);\\n  }\\n}\\n\\nexport async function createPosts(req: Request, res: Response, next: NextFunction) {\\n  try {\\n    const data = await createPostsRecord(req.body as { title: string });\\n    res.status(201).json({ success: true, data });\\n  } catch (error) {\\n    next(error);\\n  }\\n}\\n"
